{
  "layer": "top",
  "position": "top",
  "height": 24,
  "margin": 0,

  "modules-left": [
    "clock",
    "hyprland/workspaces"
  ],

  "modules-right": [
    "cpu",
    "custom/separator",
    "custom/ip",
    "custom/separator",
    "pulseaudio",
    "custom/separator",
    "bluetooth",
    "custom/separator",
    "battery",
    "custom/separator",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },

  "clock": {
    "format": "{:%H:%M}"
  },

  "custom/ip": {
    "exec": "~/.config/waybar/scripts/ip_fnnuy.sh",
    "interval": 5,
    "return-type": "json",
    "on-scroll-down": "~/.config/waybar/scripts/ip_fnnuy.sh up",
    "on-scroll-up": "~/.config/waybar/scripts/ip_fnnuy.sh down"
  },

  "pulseaudio": {
    "format": "vol: {volume}%",
    "format-muted": "vol: m"
  },

  "bluetooth": {
    "format": "bt: {device_alias}",
    "format-disabled": "bt: off",
    "format-on": "bt: on",
    "format-connected": "bt: {device_alias}",
    "tooltip": false,
    "on-click": "blueman-manager"
  },

  "battery": {
    "format": "bat: {capacity}%",
    "format-charging": "bat: {capacity}%",
    "format-plugged": "bat: {capacity}%",
    "warning": 30,
    "critical": 15,
    "tooltip": false
  },


  "tray": {
    "spacing": 6
  },

  "custom/separator": {
    "format": "|",
    "tooltip": false
  },

  "cpu": {
    "format": "cpu: {usage}%",
    "interval": 2,
    "tooltip": false,
    "max": 100,
    "warning": 80
  }
}
